{
  "id": "morph-button",
  "cat": "过渡",
  "t": "容器变形",
  "en": "morph button → input",
  "d": "按钮被点后原地变成输入框；宽度、圆角、内边距一起过渡，不是闪现。",
  "body": "\n  <div class=\"d-morph\"><input class=\"d-morph-button-morph-input\" placeholder=\"输入任务名，回车确认\"><button class=\"d-btn d-btn-primary d-morph-button-morph-btn\">＋ 新建任务</button></div>",
  "css": ".d-morph{position:relative;width:220px;height:36px}\n.d-morph .d-morph-button-morph-input,.d-morph .d-morph-button-morph-btn{position:absolute;inset:0;width:100%;height:36px;font:inherit;font-size:12px;border-radius:10px;transition:opacity .28s var(--ease),transform .28s var(--ease)}\n.d-morph .d-morph-button-morph-input{padding:0 10px;border:1px solid var(--line);background:var(--paper);color:inherit;opacity:0;transform:scaleX(.6);transform-origin:left}\n.d-morph[data-open] .d-morph-button-morph-input{opacity:1;transform:none}\n.d-morph[data-open] .d-morph-button-morph-btn{opacity:0;transform:scaleX(.6);pointer-events:none}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform .16s var(--ease),background-color .16s,color .16s,border-color .16s}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n.d-btn.d-btn-primary{background:var(--ink);color:var(--paper);border-color:var(--ink)}\n",
  "init": "root => {\n    const box = root.querySelector('.d-morph'), inp = box.querySelector('.d-morph-button-morph-input');\n    box.querySelector('.d-morph-button-morph-btn').onclick = () => { box.setAttribute('data-open', ''); inp.focus(); };\n    inp.onkeydown = e => { if (e.key === 'Escape' || e.key === 'Enter') box.removeAttribute('data-open'); };\n  }",
  "source": "lab-extra2",
  "motion": "印刷"
}
