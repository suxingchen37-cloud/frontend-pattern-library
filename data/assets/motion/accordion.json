{
  "id": "accordion",
  "cat": "布局",
  "t": "手风琴展开",
  "en": "accordion",
  "d": "高度自动过渡（用 grid-template-rows 0fr→1fr，不需要知道内容高度）。",
  "body": "<div class=\"d-acc\"><button class=\"d-btn\" data-acc>展开详情</button><div class=\"d-accordion-body\"><div class=\"d-accordion-inner\">这里是一段很长的详情内容，展开时高度平滑过渡，不需要测量 scrollHeight。</div></div></div>",
  "css": ".d-acc{width:100%}\n.d-acc .d-accordion-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows 280ms var(--ease)}\n.d-acc[data-open] .d-accordion-body{grid-template-rows:1fr}\n.d-acc .d-accordion-inner{overflow:hidden;font-size:11px;color:var(--muted);padding-top:8px}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform 180ms var(--ease),background-color 180ms,color 180ms,border-color 180ms}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n",
  "init": "root => root.querySelector('[data-acc]')?.addEventListener('click', e => {\n    const box = e.currentTarget.parentElement; box.toggleAttribute('data-open');\n    e.currentTarget.textContent = box.hasAttribute('data-open') ? '收起' : '展开详情';\n  })",
  "source": "inline",
  "motion": "印刷"
}
