{
  "id": "focus-ring",
  "cat": "无障碍",
  "t": "焦点环",
  "en": "focus-visible",
  "d": "键盘 Tab 才有环、鼠标点没有；环要 2px 且与背景有对比。",
  "body": "<button class=\"d-btn d-focus\">按 Tab 到我</button><button class=\"d-btn\">再按一次 Tab</button>",
  "css": ".d-focus:focus-visible{outline:2px solid var(--blue);outline-offset:3px}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform 180ms var(--ease),background-color 180ms,color 180ms,border-color 180ms}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n",
  "init": null,
  "source": "inline",
  "motion": "印刷"
}
