{
  "id": "mobile-tabbar",
  "cat": "导航",
  "t": "底部标签栏",
  "en": "mobile tabbar",
  "d": "手机上把四个主入口放到底部；拇指够得着，比汉堡菜单快一步。",
  "body": "<div class=\"d-mb3\"><div class=\"d-mobile-tabbar-mbscreen3\" data-mbscreen>本期</div><div class=\"d-mobile-tabbar-mbtabs3\"><button type=\"button\" data-mb3=\"本期\" class=\"d-mobile-tabbar-on\">本期</button><button type=\"button\" data-mb3=\"往期\">往期</button><button type=\"button\" data-mb3=\"收藏\">收藏</button><button type=\"button\" data-mb3=\"我的\">我的</button></div></div>",
  "css": ".d-mb3{width:178px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--paper);box-shadow:0 8px 20px #20241e12}\n.d-mobile-tabbar-mbscreen3{height:100px;display:grid;place-items:center;font-family:var(--serif);font-size:17px;background:var(--bg)}\n.d-mobile-tabbar-mbtabs3{display:flex;border-top:1px solid var(--line)}\n.d-mobile-tabbar-mbtabs3 button{flex:1;border:0;background:transparent;font-size:8.5px;color:var(--faint);padding:6px 0;cursor:pointer}\n.d-mobile-tabbar-mbtabs3 button.d-mobile-tabbar-on{color:var(--ink);font-weight:600}",
  "init": "root => {\n    const screen = root.querySelector('[data-mbscreen]');\n    root.querySelectorAll('[data-mb3]').forEach((b) => b.onclick = () => {\n      screen.textContent = b.dataset.mb3;\n      root.querySelectorAll('[data-mb3]').forEach((x) => x.classList.toggle('d-mobile-tabbar-on', x === b));\n    });\n  }",
  "source": "lab-extra3",
  "motion": "无动效"
}
