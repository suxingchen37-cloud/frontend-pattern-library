{
  "id": "offline-banner",
  "cat": "状态页",
  "t": "离线横幅",
  "en": "offline banner",
  "d": "断网时顶上出现一条，说明改动会留在本地；恢复后自己消失。",
  "body": "<div class=\"d-ob3\"><div class=\"d-offline-banner-banner3\" data-banner3 hidden>离线了 · 改动先保存在本机 <button type=\"button\" data-online3>重连</button></div><div class=\"d-offline-banner-content3\">页面内容照常可读。</div><button type=\"button\" class=\"d-offline-banner-obbtn3\" data-offline3>模拟断网</button></div>",
  "css": ".d-ob3{width:260px}\n.d-offline-banner-banner3{background:var(--ink);color:var(--paper);font-size:9.5px;padding:6px 9px;border-radius:6px;display:flex;align-items:center;gap:6px;margin-bottom:6px}\n.d-offline-banner-banner3 button{margin-left:auto;font:9px var(--mono);background:transparent;color:var(--lime);border:1px solid var(--lime);border-radius:2px;padding:1px 5px;cursor:pointer}\n.d-offline-banner-content3{border:1px dashed var(--line);border-radius:6px;padding:18px 10px;text-align:center;font-size:10.5px;color:var(--muted)}\n.d-offline-banner-obbtn3{font-size:9.5px;border:1px solid var(--line);background:var(--paper);color:var(--muted);border-radius:2px;padding:3px 8px;cursor:pointer}",
  "init": "root => {\n    const banner = root.querySelector('[data-banner3]');\n    root.querySelector('[data-offline3]').onclick = () => { banner.hidden = false; };\n    root.querySelector('[data-online3]').onclick = () => { banner.hidden = true; };\n  }",
  "source": "lab-extra3",
  "motion": "无动效"
}
