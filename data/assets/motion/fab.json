{
  "id": "fab",
  "cat": "导航",
  "t": "悬浮操作钮",
  "en": "floating action button",
  "d": "主操作悬浮在右下，点开扇出次操作；移动端高频。",
  "body": "\n  <div class=\"d-fab\"><div class=\"d-fab-acts\" hidden><button>新建任务</button><button>邀请成员</button></div><button class=\"d-fab-fab\" data-fab>＋</button></div>",
  "css": ".d-fab{position:relative;width:180px;height:120px}\n.d-fab .d-fab-fab{position:absolute;right:8px;bottom:8px;width:40px;height:40px;border-radius:999px;border:0;background:var(--ink);color:var(--paper);font-size:18px;cursor:pointer;box-shadow:0 8px 20px #20241e26;transition:transform .2s var(--ease)}\n.d-fab[data-open] .d-fab-fab{transform:rotate(45deg)}\n.d-fab .d-fab-acts{position:absolute;right:10px;bottom:56px;display:flex;flex-direction:column;gap:6px;align-items:flex-end}\n.d-fab .d-fab-acts button{font:inherit;font-size:11px;padding:6px 10px;border-radius:10px;border:1px solid var(--line);background:var(--paper);cursor:pointer;color:inherit}",
  "init": "root => {\n    const box = root.querySelector('.d-fab'), acts = box.querySelector('.d-fab-acts');\n    box.querySelector('[data-fab]').onclick = () => { const open = !box.hasAttribute('data-open'); box.toggleAttribute('data-open', open); acts.hidden = !open; };\n  }",
  "source": "lab-extra2",
  "motion": "印刷"
}
