  "body": "<div class=\"d-typing\"><i></i><i></i><i></i></div>",
  "css": ".d-typing{display:flex;gap:5px;padding:10px 14px;border-radius:999px;background:var(--paper);border:1px solid var(--line)}\n.d-typing i{width:6px;height:6px;border-radius:999px;background:var(--faint);animation:d-typing-blink 1s infinite}\n.d-typing i:nth-child(2){animation-delay:.15s}.d-typing i:nth-child(3){animation-delay:.3s}\n@keyframes d-typing-blink{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}",
  "init": null,
  "source": "inline",
  "motion": "机械"
