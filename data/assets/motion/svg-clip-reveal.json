{
  "id": "svg-clip-reveal",
  "cat": "SVG 与路径",
  "t": "图形裁剪揭示",
  "en": "svg clip reveal",
  "d": "本例通过裁剪区域展示内容，变换原点与坐标系需对应，避免从错误位置展开。方向、形状、曲线与是否使用揭示动画由内容决定。",
  "body": "<div class=\"d-cr\"><svg class=\"d-cr-art\" viewBox=\"0 0 220 120\" aria-hidden=\"true\"><defs><clipPath id=\"d-svg-clip-reveal-win\" clipPathUnits=\"userSpaceOnUse\"><rect class=\"d-cr-cut\" x=\"0\" y=\"0\" width=\"220\" height=\"120\"/></clipPath></defs><g clip-path=\"url(#d-svg-clip-reveal-win)\"><rect class=\"d-cr-block\" x=\"20\" y=\"20\" width=\"180\" height=\"80\" rx=\"6\"/><circle class=\"d-cr-ring\" cx=\"186\" cy=\"34\" r=\"26\"/><path class=\"d-cr-rule\" d=\"M20 100H200\"/></g></svg><button class=\"d-cr-btn\" type=\"button\">再揭示</button></div>",
  "css": ".d-cr{display:flex;flex-direction:column;align-items:flex-start;gap:8px}\n.d-cr-art{display:block;width:220px;height:120px;cursor:pointer}\n.d-cr-block{fill:#2b4b8f}\n.d-cr-ring{fill:none;stroke:var(--ink);stroke-width:1}\n.d-cr-rule{stroke:var(--line);stroke-width:1}\n.d-cr-cut{transform-box:fill-box;transform-origin:100% 100%;transform:scale(1)}\n.d-cr.is-open .d-cr-cut{animation:d-svg-clip-reveal-open 900ms cubic-bezier(.2,.75,.25,1) both}\n@keyframes d-svg-clip-reveal-open{from{transform:scale(0)}to{transform:scale(1)}}\n.d-cr-btn{font-family:var(--font-mono);font-size:var(--fs-11);letter-spacing:var(--tracking-mono-label);padding:8px 12px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--muted);cursor:pointer}\n.d-cr-btn:hover{border-color:var(--ink);color:var(--ink)}\n.d-cr-btn:focus-visible{outline:1px solid var(--ink);outline-offset:2px}",
  "init": "root => {\n    const box = root.querySelector('.d-cr'), art = box.querySelector('.d-cr-art'), cut = box.querySelector('.d-cr-cut'), btn = box.querySelector('.d-cr-btn');\n    let corner = '100% 100%';\n    const open = () => {\n      cut.style.transformOrigin = corner;\n      box.classList.remove('is-open');\n      void art.getBoundingClientRect();\n      box.classList.add('is-open');\n    };\n    art.onclick = e => {\n      const r = art.getBoundingClientRect();\n      corner = ((e.clientX - r.left) / r.width > .5 ? '100% ' : '0% ') + ((e.clientY - r.top) / r.height > .5 ? '100%' : '0%');\n      open();\n    };\n    btn.onclick = open;\n    open();\n  }",
  "source": "v4",
  "motion": "印刷",
  "tags": [
    "裁剪",
    "揭示",
    "路径",
    "角"
  ]
}
