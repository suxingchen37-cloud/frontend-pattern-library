{
  "id": "toggle-spring",
  "cat": "微交互",
  "t": "弹簧开关",
  "en": "spring switch",
  "d": "开关的滑块带一点过冲，比线性更「活」。",
  "body": "<button class=\"d-sw\" role=\"switch\" aria-checked=\"false\"><i></i></button>",
  "css": ".d-sw{width:46px;height:26px;border-radius:999px;border:1px solid var(--line);background:color-mix(in srgb,var(--ink) 10%,transparent);position:relative;cursor:pointer;transition:background 180ms}\n.d-sw i{position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:999px;background:var(--paper);box-shadow:0 1px 3px #0002;transition:transform 280ms var(--ease-spring)}\n.d-sw[aria-checked=true]{background:var(--lime)}\n.d-sw[aria-checked=true] i{transform:translateX(20px)}",
  "init": "root => root.querySelector('.d-sw')?.addEventListener('click', e => {\n    const b = e.currentTarget; b.setAttribute('aria-checked', b.getAttribute('aria-checked') === 'true' ? 'false' : 'true');\n  })",
  "source": "inline",
  "motion": "物理"
}
