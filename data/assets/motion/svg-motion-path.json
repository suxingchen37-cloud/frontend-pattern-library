{
  "id": "svg-motion-path",
  "cat": "SVG 与路径",
  "t": "沿路径运动",
  "en": "motion path",
  "d": "圆点用 offset-path 沿弧长跑，中段曲率最大的地方也不会被拽快——写四组 translate 关键帧做不到匀速；offset-rotate 必须设 0deg 关掉自动朝向，否则点会自己跟着切线打转。",
  "body": "<div class=\"d-mp\"><svg class=\"d-mp-art\" viewBox=\"0 0 260 112\" aria-hidden=\"true\"><path class=\"d-mp-curve\" d=\"M14 88C58 88 62 26 108 26S164 88 208 66 236 22 246 30\"/></svg><i class=\"d-mp-dot\"></i><button class=\"d-mp-btn\" type=\"button\" aria-pressed=\"false\">暂停</button></div>",
  "css": ".d-mp{position:relative;width:260px;height:112px}\n.d-mp-art{display:block;width:260px;height:112px}\n.d-mp-curve{fill:none;stroke:var(--line);stroke-width:1}\n.d-mp-dot{position:absolute;left:0;top:0;width:6px;height:6px;border-radius:999px;background:#c2402a;offset-path:path(\"M14 88C58 88 62 26 108 26S164 88 208 66 236 22 246 30\");offset-rotate:0deg;animation:d-svg-motion-path-run 900ms linear infinite}\n@keyframes d-svg-motion-path-run{from{offset-distance:0%}to{offset-distance:100%}}\n.d-mp.is-paused .d-mp-dot{animation-play-state:paused}\n.d-mp-btn{position:absolute;right:0;bottom:0;font-family:var(--font-mono);font-size:var(--fs-11);letter-spacing:var(--tracking-mono-label);padding:8px 12px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--muted);cursor:pointer}\n.d-mp-btn:hover{border-color:var(--ink);color:var(--ink)}\n.d-mp-btn:focus-visible{outline:1px solid var(--ink);outline-offset:2px}\n@media (prefers-reduced-motion: reduce){.d-mp-dot{animation:none;offset-distance:100%}}",
  "init": "root => {\n    const box = root.querySelector('.d-mp'), btn = box.querySelector('.d-mp-btn');\n    btn.onclick = () => {\n      const paused = box.classList.toggle('is-paused');\n      btn.textContent = paused ? '继续' : '暂停';\n      btn.setAttribute('aria-pressed', String(paused));\n    };\n  }",
  "source": "v4",
  "motion": "机械",
  "tags": [
    "路径",
    "运动",
    "曲线",
    "匀速"
  ]
}
