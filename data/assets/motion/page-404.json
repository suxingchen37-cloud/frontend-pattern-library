{
  "id": "page-404",
  "cat": "状态页",
  "t": "404 页",
  "en": "404 page",
  "d": "找不到页面时，先承认，再给一个能走的方向；不要放一个巨大的插画然后没有出口。",
  "body": "<div class=\"d-p404\"><b>404</b><p>这页可能被移动了，或者从来没存在过。</p><button type=\"button\" data-back3>回到本期</button><em data-backmsg3></em></div>",
  "css": ".d-p404{width:250px;text-align:center;padding:10px}\n.d-p404 b{display:block;font-family:var(--serif);font-size:54px;line-height:1;letter-spacing:-.04em}\n.d-p404 p{margin:8px 0 12px;font-size:11px;color:var(--muted);line-height:1.7}\n.d-p404 button{font-size:10.5px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:999px;padding:6px 12px;cursor:pointer}\n.d-p404 em{display:block;margin-top:8px;font:9px var(--mono);color:var(--faint);font-style:normal}",
  "init": "root => root.querySelector('[data-back3]').onclick = (e) => {\n    e.target.textContent = '已回到本期（演示）';\n    root.querySelector('[data-backmsg3]').textContent = '这里本该跳转，演示里只改按钮。';\n  }",
  "source": "lab-extra3",
  "motion": "无动效"
}
