{
  "id": "optimistic",
  "cat": "加载",
  "t": "乐观上屏",
  "en": "optimistic send",
  "d": "按下发送立刻出现半透明消息，失败再标红；这是聊天里最重要的一个感。",
  "body": "<div class=\"d-opt\"><div class=\"d-optimistic-m d-optimistic-mine\">这条已经在屏幕上<em>发送中…</em></div></div><button class=\"d-btn\" data-opt>模拟发送</button>",
  "css": ".d-opt{display:flex;flex-direction:column;gap:6px;width:100%}\n.d-opt .d-optimistic-m{align-self:flex-end;padding:8px 12px;border-radius:10px;background:#dce8c8;color:#141a10;font-size:11px;display:flex;gap:8px;align-items:center;transition:opacity 280ms}\n.d-opt .d-optimistic-m em{font-style:normal;font-size:9px;color:#5d6f49}\n.d-opt .d-optimistic-m.fail{background:#ffe1da;color:#7a2b18}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform 180ms var(--ease),background-color 180ms,color 180ms,border-color 180ms}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n",
  "init": "root => root.querySelector('[data-opt]')?.addEventListener('click', () => {\n    const box = root.querySelector('.d-opt'); const m = document.createElement('div'); m.className = 'd-optimistic-m d-optimistic-mine';\n    m.innerHTML = '临时消息 <em>发送中…</em>'; box.appendChild(m);\n    setTimeout(() => { const em = m.querySelector('em'); em.textContent = '已送达'; }, 1200);\n  })",
  "source": "inline",
  "motion": "印刷"
}
