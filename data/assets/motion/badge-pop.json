{
  "id": "badge-pop",
  "cat": "反馈",
  "t": "角标跳动",
  "en": "badge pop",
  "d": "未读/待办数字变化时弹一下，提醒但不打断。",
  "body": "<div class=\"d-badge2\">收件箱 <b>3</b></div><button class=\"d-btn\" data-badge2>+1</button>",
  "css": ".d-badge2{display:flex;align-items:center;gap:8px;font-size:12px}\n.d-badge2 b{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--coral);color:#fff;font-size:10.5px}\n.d-badge2 b.on{animation:d-pop .42s var(--ease-spring)}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform .16s var(--ease),background-color .16s,color .16s,border-color .16s}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n",
  "init": "root => root.querySelector('[data-badge2]')?.addEventListener('click', () => {\n    const b = root.querySelector('.d-badge2 b'); b.textContent = String(Number(b.textContent || 0) + 1);\n    b.classList.remove('on'); void b.offsetWidth; b.classList.add('on');\n  })",
  "source": "inline",
  "motion": "物理"
}
