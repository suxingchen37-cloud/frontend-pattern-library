{
  "id": "hotspots",
  "cat": "媒体",
  "t": "图片热点",
  "en": "hotspots",
  "d": "在图上点一个小点看说明；适合产品图、平面图和教学图。",
  "body": "<div class=\"d-hs3\"><button type=\"button\" class=\"d-hotspots-hot3\" style=\"--x:24%;--y:32%\" data-hot3=\"招牌底板 1.2m × 0.6m，深绿底白字。\">+</button><button type=\"button\" class=\"d-hotspots-hot3\" style=\"--x:62%;--y:24%\" data-hot3=\"字高 38cm，街对面能看清笔画。\">+</button><button type=\"button\" class=\"d-hotspots-hot3\" style=\"--x:52%;--y:70%\" data-hot3=\"字距 4cm，远看才不糊。\">+</button><div class=\"d-hotspots-hottip3\" data-hottip hidden></div></div>",
  "css": ".d-hs3{width:260px;height:130px;border:1px solid var(--line);border-radius:10px;position:relative;background:repeating-linear-gradient(0deg,var(--bg) 0 20px,var(--paper) 20px 40px);overflow:hidden}\n.d-hotspots-hot3{position:absolute;left:var(--x);top:var(--y);width:16px;height:16px;border-radius:50%;border:1px solid var(--ink);background:var(--lime);color:#141a10;font:10px/1 var(--mono);cursor:pointer;padding:0}\n.d-hotspots-hottip3{position:absolute;left:10px;right:10px;bottom:9px;background:var(--ink);color:var(--paper);font-size:9px;line-height:1.6;padding:6px 8px;border-radius:6px}",
  "init": "root => {\n    const tip = root.querySelector('[data-hottip]');\n    root.querySelectorAll('[data-hot3]').forEach((b) => b.onclick = () => {\n      const same = !tip.hidden && tip.dataset.owner === b.dataset.hot3;\n      tip.hidden = same;\n      tip.dataset.owner = b.dataset.hot3;\n      tip.textContent = b.dataset.hot3;\n    });\n  }",
  "source": "lab-extra3",
  "motion": "无动效"
}
