{
  "id": "cube-flip",
  "cat": "3D 与透视",
  "t": "立方体翻转",
  "en": "cube flip",
  "d": "90° 是面间夹角，多一度露缝、少一度会看到第二条面；两面必须同尺寸同圆角，否则转过去边缘对不齐，这是立方体最容易露馅的地方。B 面给 34px 大字压在朱墨块上：换面时最先被认出来的是整块颜色，不是小字。",
  "body": "<button type=\"button\" class=\"d-cube\" aria-pressed=\"false\" aria-label=\"立方体翻转：A 面与 B 面互换\"><span class=\"d-cube-in\"><span class=\"d-cube-face d-cube-a\"><span class=\"d-cube-ch\">A</span><span class=\"d-cube-k\">正面</span></span><span class=\"d-cube-face d-cube-b\"><span class=\"d-cube-ch\">B</span><span class=\"d-cube-k\">底面</span></span></span></button>",
  "css": ".d-cube{position:relative;box-sizing:border-box;width:300px;max-width:100%;height:150px;padding:0;border:0;background:none;font:inherit;color:inherit;cursor:pointer;perspective:700px;-webkit-tap-highlight-color:transparent}\n.d-cube-in{position:absolute;left:50%;top:8px;width:124px;height:124px;margin-left:-62px;display:block;transform-style:preserve-3d;transition:transform 280ms cubic-bezier(.34,1.56,.64,1)}\n.d-cube-on .d-cube-in{transform:rotateX(90deg)}\n.d-cube-face{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;box-sizing:border-box;border:1px solid var(--line);border-radius:6px;background:var(--paper);backface-visibility:hidden}\n.d-cube-a{transform:translateZ(62px)}\n.d-cube-b{transform:rotateX(-90deg) translateZ(62px);background:#c2402a;border-color:#c2402a;color:var(--paper)}\n.d-cube-ch{font-size:34px;font-weight:700;line-height:1;letter-spacing:-.03em}\n.d-cube-k{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;opacity:.65}\n.d-cube:focus-visible{outline:1px solid var(--ink);outline-offset:2px}",
  "init": "root => {\n  const box = root.querySelector('.d-cube');\n  if (!box) return;\n  box.onclick = () => {\n    const on = !box.classList.contains('d-cube-on');\n    box.classList.toggle('d-cube-on', on);\n    box.setAttribute('aria-pressed', on ? 'true' : 'false');\n  };\n}",
  "source": "v4",
  "motion": "物理",
  "tags": [
    "立方体",
    "翻转",
    "换面",
    "立体"
  ]
}
