{
  "id": "skip-target",
  "cat": "导航",
  "t": "跳到正文",
  "en": "skip link",
  "d": "键盘用户按 Tab 时最先出现的链接；跳过导航，直达正文。",
  "body": "<div class=\"d-st3\"><a class=\"d-skip-target-skip3\" href=\"#\" data-skip3>跳到正文</a><div class=\"d-skip-target-sthead3\">导航 · 本期 · 往期 · 关于</div><div class=\"d-skip-target-sttarget3\" data-target3 tabindex=\"-1\">正文从这里开始。这个链接平时藏起来，按 Tab 才出现。</div></div>",
  "css": ".d-st3{width:250px;border:1px solid var(--line);border-radius:6px;padding:8px;position:relative;background:var(--paper)}\n.d-skip-target-skip3{position:absolute;left:-999px;top:4px;background:var(--ink);color:var(--paper);font-size:10px;padding:4px 8px;border-radius:2px;z-index:2}\n.d-skip-target-skip3:focus{left:6px}\n.d-skip-target-sthead3{font:9px var(--mono);color:var(--faint);padding:4px 0 8px;border-bottom:1px solid var(--line);margin-bottom:8px}\n.d-skip-target-sttarget3{font-size:10.5px;color:var(--muted);line-height:1.7;padding:6px;border-radius:2px;outline:none}\n.d-skip-target-sttarget3.flash{background:var(--lime);color:#141a10}",
  "init": "root => {\n    const link = root.querySelector('[data-skip3]'), target = root.querySelector('[data-target3]');\n    link.onclick = (e) => {\n      e.preventDefault();\n      target.focus();\n      target.classList.add('flash');\n      setTimeout(() => target.classList.remove('flash'), 900);\n    };\n  }",
  "source": "lab-extra3",
  "motion": "无动效"
}
