{
  "id": "sidebar-collapse",
  "cat": "布局",
  "t": "侧栏折叠",
  "en": "collapsible sidebar",
  "d": "图标条 ↔ 文字栏，宽度过渡 + 文字淡出；折叠后仍能点。",
  "body": "\n  <div class=\"d-sb\" data-open><div class=\"d-sidebar-collapse-rail2\"><button data-sb>☰</button><span>对</span><span>伙</span><span>记</span></div><div class=\"d-sidebar-collapse-panel2\">标签栏<br><small>文字在这里淡出</small></div></div>",
  "css": ".d-sb{display:flex;height:100px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--paper)}\n.d-sb .d-sidebar-collapse-rail2{width:48px;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:6px;padding:6px 0;background:color-mix(in srgb,var(--ink) 6%,transparent);font-size:11px;color:var(--muted);transition:width 280ms var(--ease)}\n.d-sb .d-sidebar-collapse-panel2{flex:1;min-width:0;padding:8px 10px;font-size:11px;color:var(--muted);opacity:1;transition:opacity 180ms}\n.d-sb:not([data-open]) .d-sidebar-collapse-panel2{opacity:0}\n.d-sb .d-sidebar-collapse-rail2 button{border:0;background:transparent;cursor:pointer;font:inherit;color:inherit}",
  "init": "root => root.querySelector('[data-sb]').onclick = () => root.querySelector('.d-sb').toggleAttribute('data-open')",
  "source": "lab-extra2",
  "motion": "印刷"
}
