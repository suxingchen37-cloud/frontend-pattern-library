{
  "id": "bars-grow",
  "cat": "数据",
  "t": "柱状生长",
  "en": "bars grow",
  "d": "图表首次出现时从 0 长到目标值，错峰 40ms。",
  "body": "<div class=\"d-bars\"><i style=\"--v:40%\"></i><i style=\"--v:72%\"></i><i style=\"--v:56%\"></i><i style=\"--v:90%\"></i></div>",
  "css": ".d-bars{display:flex;align-items:flex-end;gap:8px;height:80px}\n.d-bars i{width:18px;border-radius:6px 6px 0 0;background:var(--lime);height:0;animation:d-bars-grow-bar .7s var(--ease) forwards}\n.d-bars i:nth-child(2){animation-delay:40ms}.d-bars i:nth-child(3){animation-delay:80ms}.d-bars i:nth-child(4){animation-delay:120ms}\n@keyframes d-bars-grow-bar{to{height:var(--v)}}",
  "init": null,
  "source": "inline",
  "motion": "印刷"
}
