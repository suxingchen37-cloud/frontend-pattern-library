{
  "id": "stat-spark",
  "cat": "数据",
  "t": "指标卡 + 迷你折线",
  "en": "stat card + sparkline",
  "d": "一个数 + 一条趋势线，比纯数字有信息量。",
  "body": "<div class=\"d-stat\"><span>本周产出</span><b>18</b><svg viewBox=\"0 0 80 24\"><polyline points=\"0,18 12,14 24,16 36,8 48,10 60,4 72,6 80,2\"/></svg></div>",
  "css": ".d-stat{width:150px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--paper);display:flex;flex-direction:column;gap:2px}\n.d-stat span{font-size:9px;color:var(--faint)}\n.d-stat b{font-size:21px;letter-spacing:-.03em;font-variant-numeric:tabular-nums}\n.d-stat svg{width:100%;height:24px;margin-top:4px}\n.d-stat polyline{fill:none;stroke:var(--ink);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}",
  "init": null,
  "source": "lab-more",
  "motion": "无动效"
}
