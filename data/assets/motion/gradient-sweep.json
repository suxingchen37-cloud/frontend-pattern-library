{
  "id": "gradient-sweep",
  "cat": "排印",
  "t": "渐变扫光",
  "en": "gradient sweep",
  "d": "标题上一道光扫过；只在「生成完成」时放一次，常驻会廉价。",
  "body": "<div class=\"d-grad\">已完成</div>",
  "css": ".d-grad{font-size:20px;font-weight:750;background:linear-gradient(90deg,var(--ink) 30%,var(--faint) 50%,var(--ink) 70%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:d-gradient-sweep-kf 2.4s var(--ease) infinite}\n@keyframes d-gradient-sweep-kf{from{background-position:200% 0}to{background-position:-200% 0}}",
  "init": null,
  "source": "inline",
  "motion": "印刷"
}
