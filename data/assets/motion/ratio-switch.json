{
  "id": "ratio-switch",
  "cat": "媒体",
  "t": "比例容器",
  "en": "aspect-ratio",
  "d": "同一块内容在 1:1、16:9、4:5 之间切换；先定比例，再谈裁切。",
  "body": "<div class=\"d-rsz3\"><div class=\"d-ratio-switch-rzbox3\" data-ratio3><span data-rlabel3>16:9</span></div><div class=\"d-ratio-switch-rzbtns3\"><button type=\"button\" data-r3=\"1/1\">1:1</button><button type=\"button\" data-r3=\"16/9\" class=\"d-ratio-switch-on\">16:9</button><button type=\"button\" data-r3=\"4/5\">4:5</button></div></div>",
  "css": ".d-rsz3{width:200px}\n.d-ratio-switch-rzbox3{aspect-ratio:16/9;border:1px solid var(--line);border-radius:6px;background:repeating-linear-gradient(90deg,var(--bg) 0 18px,var(--paper) 18px 36px);display:grid;place-items:center;transition:aspect-ratio .2s}\n.d-ratio-switch-rzbox3 span{font:9px var(--mono);color:var(--faint);background:var(--paper);padding:1px 5px;border-radius:2px}\n.d-ratio-switch-rzbtns3{display:flex;gap:4px;margin-top:6px}\n.d-ratio-switch-rzbtns3 button{font-size:9.5px;border:1px solid var(--line);background:var(--paper);border-radius:2px;padding:2px 7px;cursor:pointer}\n.d-ratio-switch-rzbtns3 button.d-ratio-switch-on{background:var(--ink);color:var(--paper);border-color:var(--ink)}",
  "init": "root => {\n    const box = root.querySelector('[data-ratio3]'), label = root.querySelector('[data-rlabel3]');\n    root.querySelectorAll('[data-r3]').forEach((b) => b.onclick = () => {\n      box.style.aspectRatio = b.dataset.r3;\n      label.textContent = b.textContent;\n      root.querySelectorAll('[data-r3]').forEach((x) => x.classList.toggle('d-ratio-switch-on', x === b));\n    });\n  }",
  "source": "lab-extra3",
  "motion": "印刷"
}
