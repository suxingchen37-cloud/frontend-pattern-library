{
  "id": "fade-stagger",
  "cat": "入场",
  "t": "错峰淡入",
  "en": "staggered fade-up",
  "d": "列表/卡片依次出现，每项延迟 40ms；最基础也最耐看的入场。",
  "body": "\n  <div class=\"d-stack\"><i class=\"d-chip\"></i><i class=\"d-chip\"></i><i class=\"d-chip\"></i><i class=\"d-chip\"></i></div>\n  <button class=\"d-btn\" data-replay>重播</button>",
  "css": ".d-stack{display:flex;flex-direction:column;gap:8px}\n.d-chip{width:120px;height:12px;border-radius:6px;background:color-mix(in srgb,var(--ink) 18%,transparent);opacity:0;animation:d-fade-stagger-in .45s var(--ease) forwards}\n.d-chip:nth-child(1){animation-delay:0ms}.d-chip:nth-child(2){animation-delay:40ms}.d-chip:nth-child(3){animation-delay:80ms}.d-chip:nth-child(4){animation-delay:120ms}\n@keyframes d-fade-stagger-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\n.d-btn{font:inherit;font-size:13px;padding:8px 16px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer;transition:transform 180ms var(--ease),background-color 180ms,color 180ms,border-color 180ms}\n.d-btn:hover{box-shadow:0 6px 18px #20241e14}\n.d-btn:active{transform:scale(.97)}\n",
  "init": "root => root.querySelector('[data-replay]')?.addEventListener('click', () => {\n    root.querySelectorAll('.d-chip').forEach(c => { c.style.animation = 'none'; void c.offsetWidth; c.style.animation = ''; });\n  })",
  "source": "inline",
  "motion": "印刷"
}
