{
  "version": "1.0.0",
  "theme": "印刷厂 paper / letterpress",
  "palette": {
    "paper": {
      "bg": "#f3f1e9",
      "panel": "#fbfaf5"
    },
    "night": {
      "bg": "#121610",
      "panel": "#191d18"
    },
    "ink": {
      "main": "#20241e",
      "muted": "#6b7860",
      "faint": "#94a184",
      "line": "#deded2"
    },
    "inkNight": {
      "main": "#e8efe0",
      "muted": "#a9b8a0",
      "faint": "#7b8a72",
      "line": "#2c3327"
    },
    "inks": {
      "vermilion": "#c2402a",
      "indigo": "#2b4b8f",
      "yellow": "#e8c34a",
      "policy": "一页最多用两种油墨，禁止三色同屏"
    },
    "marker": {
      "hi": "#d9f875",
      "policy": "只作荧光标记笔，全站 ≤3 处，禁作主色或大面积背景"
    },
    "status": {
      "ok": "#3d7347",
      "warn": "#a8502f",
      "okNight": "#8fd3a4",
      "warnNight": "#f0a184",
      "policy": "只在成功/警示语义出现，不作装饰色；值沿用 design-system.html 已有的 --ok/--warn"
    },
    "retired": {
      "lav": "#c4b6ff 从新资产中退役，存量按批次替换"
    }
  },
  "type": {
    "scale": [
      9,
      11,
      13,
      15,
      21,
      34,
      56,
      96
    ],
    "lineHeight": {
      "body": 1.7,
      "note": 1.6,
      "display": 1.05
    },
    "tracking": {
      "display": "-0.03em",
      "body": "0",
      "monoLabel": "0.08em"
    },
    "families": {
      "sans": "Inter,-apple-system,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif",
      "serif": "Songti SC,STSong,Noto Serif CJK SC,SimSun,serif",
      "mono": "ui-monospace,SFMono-Regular,Menlo,monospace"
    }
  },
  "space": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      40,
      64,
      96
    ],
    "policy": "只用 4 的倍数且必须命中本表"
  },
  "radius": {
    "table": 0,
    "tag": 2,
    "control": 6,
    "card": 10,
    "pill": 999,
    "policy": "按层级分档，禁止全站同值；pill 每页 ≤3 处"
  },
  "duration": {
    "feedback": 120,
    "move": 180,
    "reveal": 280,
    "ambient": 900,
    "policy": "超过 900ms 必须写明理由"
  },
  "easing": {
    "mechanical": {
      "name": "机械",
      "value": "linear | steps(6)",
      "use": "数据、加载、仪器"
    },
    "physical": {
      "name": "物理",
      "value": "cubic-bezier(.34,1.56,.64,1)",
      "use": "拖拽、弹层、手势"
    },
    "print": {
      "name": "印刷",
      "value": "cubic-bezier(.2,.75,.25,1)",
      "use": "揭示、转场、排印"
    }
  },
  "shadow": {
    "divider": "0 1px 0 var(--line)",
    "press": "inset 0 1px 0 #fff5",
    "overlay": "0 12px 24px -8px #20241e26",
    "policy": "无软阴影档；overlay 只给真浮层，卡片禁用"
  },
  "border": {
    "default": "1px var(--line)",
    "strong": "1px var(--ink)",
    "policy": "禁止加粗到 2px 表强调"
  }
}
