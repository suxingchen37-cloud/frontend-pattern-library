{
  "version": "1.0.0",
  "theme": "仅用于预览的运行占位；不预设消费方风格",
  "palette": {
    "paper": {
      "bg": "#f3f1e9",
      "panel": "#fbfaf5"
    },
    "night": {
      "bg": "#121610",
      "panel": "#191d18"
    },
    "ink": {
      "main": "#20241e",
      "muted": "#6b7860",
      "faint": "#94a184",
      "line": "#deded2"
    },
    "inkNight": {
      "main": "#e8efe0",
      "muted": "#a9b8a0",
      "faint": "#7b8a72",
      "line": "#2c3327"
    },
    "inks": {
      "vermilion": "#c2402a",
      "indigo": "#2b4b8f",
      "yellow": "#e8c34a",
      "policy": "这些色值仅用于预览；正式项目按内容和品牌决定配色与强调方式"
    },
    "marker": {
      "hi": "#d9f875",
      "policy": "预览标记示例，不规定强调色、出现次数或使用面积"
    },
    "status": {
      "ok": "#3d7347",
      "warn": "#a8502f",
      "okNight": "#8fd3a4",
      "warnNight": "#f0a184",
      "policy": "预览状态示例；消费方定义可辨识且一致的状态语义"
    },
    "retired": {
      "lav": "#c4b6ff 历史预览色，正式项目可按需求使用"
    }
  },
  "type": {
    "scale": [
      9,
      11,
      13,
      15,
      21,
      34,
      56,
      96
    ],
    "lineHeight": {
      "body": 1.7,
      "note": 1.6,
      "display": 1.05
    },
    "tracking": {
      "display": "-0.03em",
      "body": "0",
      "monoLabel": "0.08em"
    },
    "families": {
      "sans": "Inter,-apple-system,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif",
      "serif": "Songti SC,STSong,Noto Serif CJK SC,SimSun,serif",
      "mono": "ui-monospace,SFMono-Regular,Menlo,monospace"
    }
  },
  "space": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      40,
      64,
      96
    ],
    "policy": "预览间距示例；消费方按内容关系定义尺度"
  },
  "radius": {
    "table": 0,
    "tag": 2,
    "control": 6,
    "card": 10,
    "pill": 999,
    "policy": "预览圆角示例；消费方可使用任意自洽的圆角体系"
  },
  "duration": {
    "feedback": 120,
    "move": 180,
    "reveal": 280,
    "ambient": 900,
    "policy": "预览时长示例；按距离、状态与用户任务调整并尊重 reduced-motion"
  },
  "easing": {
    "mechanical": {
      "name": "机械",
      "value": "linear | steps(6)",
      "use": "数据、加载、仪器"
    },
    "physical": {
      "name": "物理",
      "value": "cubic-bezier(.34,1.56,.64,1)",
      "use": "拖拽、弹层、手势"
    },
    "print": {
      "name": "印刷",
      "value": "cubic-bezier(.2,.75,.25,1)",
      "use": "揭示、转场、排印"
    }
  },
  "shadow": {
    "divider": "0 1px 0 var(--line)",
    "press": "inset 0 1px 0 #fff5",
    "overlay": "0 12px 24px -8px #20241e26",
    "policy": "预览阴影示例；可选择描边、阴影、留白或其他适合的分层方式"
  },
  "border": {
    "default": "1px solid var(--line)",
    "strong": "1px solid var(--ink)",
    "policy": "预览描边示例；消费方根据对比度、焦点与内容关系调整"
  }
}
